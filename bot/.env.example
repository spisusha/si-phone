# Скопируй этот файл в .dev.vars (для локальной разработки с wrangler)
# В Cloudflare Workers секреты задаются через wrangler secret put

# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# MINI_APP_URL задана в wrangler.toml — менять там при необходимости

# chat_id админов через запятую (секрет, не в wrangler.toml)
ADMIN_CHAT_ID=

# Секрет вебхука: бот принимает только запросы Telegram с этим заголовком.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEBHOOK_SECRET=
